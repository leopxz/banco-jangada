# Copie este arquivo para .env e preencha com as chaves de SANDBOX da Plaid.
# O .env NUNCA vai para o GitHub (está no .gitignore).
PLAID_CLIENT_ID=COLE_SEU_CLIENT_ID
PLAID_SECRET=COLE_SEU_SANDBOX_SECRET
# Token do Item criado pelo MCP no Claude Desktop (ou deixe vazio e rode com --criar-item)
PLAID_ACCESS_TOKEN=
